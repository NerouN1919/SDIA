@startuml

title Context Map

' BC
rectangle "Customer BC" as customer
rectangle "Wallet BC" as wallet
rectangle "Transaction BC" as payments
rectangle "Notifications BC" as notifications
rectangle "Anti-Fraud / Scoring BC" as anti_fraud
rectangle "Merchant BC" as merchant
rectangle "Auth BC" as auth
rectangle "Orchestrator BC" as orchestrator
rectangle "Callback Provider BC" as callback_provider

' Внешние сервисы
rectangle "Платёжный провайдер Ext" as payment_provider
rectangle "Мерчанты Ext" as merchant_ext
rectangle "Core Banking Ext" as core_banking

' Связи
orchestrator --> payments: U/D C/S
orchestrator --> wallet: U/D C/S
payments --> wallet: U/D P/L
wallet --> payments: U/D P/L
payments --> core_banking: U/D ACL
payments --> notifications: U/D PL
payments --> anti_fraud: U/D C/S
payments --> merchant: U/D C/S
payments --> customer: U/D C/S
wallet --> customer: U/D C/S
merchant --> merchant_ext: U/D OHS PL
payments --> payment_provider: U/D OHS PL
anti_fraud --> wallet: U/D C/S
customer --> auth: U/D C/S
merchant --> auth: U/D C/S
callback_provider --> payments: U/D P/L
@enduml